{
    "name": "awcodes/heatmap-widget",
    "description": "A GitHub-style contribution heatmap widget for Filament.",
    "keywords": [
        "awcodes",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "heatmap-widget"
    ],
    "homepage": "https://github.com/awcodes/heatmap-widget",
    "support": {
        "issues": "https://github.com/awcodes/heatmap-widget/issues",
        "source": "https://github.com/awcodes/heatmap-widget"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Adam Weston",
            "email": "adam@awcodes.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Awcodes\\HeatmapWidget\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Awcodes\\HeatmapWidget\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "refactor": "rector",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:types": "phpstan analyse",
        "test:unit": "pest",
        "test": [
            "@test:refactor",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Awcodes\\HeatmapWidget\\HeatmapWidgetServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
